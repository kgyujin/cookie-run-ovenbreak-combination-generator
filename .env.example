# 짧은 공유 링크용 Supabase (공개 키라서 브라우저에 노출돼도 괜찮음)
# Supabase 대시보드 → Project Settings → API 에서 확인
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# 관리자 페이지 (선택). 비밀 값이라 저장소에 올리면 안 돼요.
# 로컬에서는 .env.local(깃에 안 올라감)에, 배포는 Vercel 환경변수에만 넣어 주세요.
STUDIO_PATH=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
STUDIO_SESSION_SECRET=

# 관리자 페이지 로컬 모드 (선택). npm run dev 일 때만 켜져요.
# 1로 두면 http://localhost:3000/studio-local 에서 로그인 없이 관리하고, 저장하면 프로젝트 폴더의 파일이 바로 바뀌어요.
STUDIO_LOCAL=
